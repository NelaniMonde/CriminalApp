@model List<Suspects>

<partial name="_Notifications" />
<body>
 <h1 id="showsuspectsView" class="text-white glassBackground" style="width:fit-content; margin-top:8%; margin-bottom:5%;">Showing suspects</h1>





    <!-- for adding to the class incase there is an error (me-1g-n5)  -->

    <div class="card rounded-3  border p-3 mt-5 glassBackground horizScroll" style="width:100%; ">
<table id="MainTable" class="table-bordered border-secondary text-white">
    <thead>
        <tr>
            <th>Suspect ID</th>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Number of Criminal Charges</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            if (item.CriminalRecords!=null)
            {
                <tr>
                <td>@item.SuspectID</td>
                <td>@item.FirstName</td>
                <td>@item.LastName</td>
                <td>@item.CriminalRecords.Count()</td>
                <td>
                    <div>
                      <a asp-controller="Criminal" asp-action="CriminalRecordView"
                                       asp-route-SuspectNo="@item.SuspectNo" asp-route-ViewName="ShowSuspects"
                                       class="btn btn-primary glassBackground" style="width:200px">Create Criminal Record</a>
                    </div>
                </td>
                </tr>
            }
            else
            {

                <tr>
                    <td>@item.SuspectID</td>
                    <td>@item.FirstName</td>
                    <td>@item.LastName</td>
                    <td>0</td>
                    <td>
                        <div>
                            <a asp-controller="Criminal" asp-action="CriminalRecordView"
                                       asp-route-ViewName="ShowSuspects"
                            asp-route-SuspectNo="@item.SuspectNo" class="btn btn-primary glassBackground" style="width:200px">Create Criminal Record</a>
                        </div>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
</div>
</body>


@section Scripts {
    <script>
            $(document).ready( function () {
                $('#MainTable').DataTable(
                    {
                         'responsive':true,
                           columnDefs: [
                        { responsivePriority: 1, targets: 1 },
                        {  responsivePriority: -1, targets: 4 } 
                        ]
                    });

                    // Info text ("Showing 1 to 10 of ...")
                     $('.dt-container .dt-info').css('color', 'white');


                    // $('.dataTables_filter input').addClass('glassBackground');
        } );
    </script>
}