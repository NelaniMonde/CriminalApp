@model Suspects

<partial name="_Notifications" />
<body>
    <form id="updateSuspect" method="post" asp-action="UpdateSuspect" style="margin-top:5.98%; margin-left:15.6%; width:70%; ">
        <div class="card rounded-3 me-1g-n5 border p-3 mt-4  glassBackground text-white-50">
        <div class="row pb-2">
            <h2 class="text-white">Update Suspect</h2>

            <hr />
        </div>

        <div class="mb-3 row ">
            <label class="col-sm-2 col-form-label">SuspectNo  </label>
            <div class="col-sm-10">
                <input type="hidden" asp-for="SuspectNo" class="form-control" />
            </div>
        </div>

        <div class="mb-3 row">
            <label class="col-sm-2 col-form-label">Suspect ID:  </label>
            <div class="col-sm-10">
                <input asp-for="SuspectID" class="form-control" placeholder="ID Number" />
                <span asp-validation-for="SuspectID" class="text-danger"></span>

            </div>
        </div>

        <div class="mb-3 row">
            <label class="col-sm-2 col-form-label">First Name:  </label>
            <div class="col-sm-10">
                <input asp-for="FirstName" class="form-control" placeholder="First Name" />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>
        </div>


        <div class="mb-3 row">
            <label class="col-sm-2 col-form-label">Last Name:  </label>
            <div class="col-sm-10">
                <input asp-for="LastName" class="form-control" placeholder="last Name" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>
        </div>

            <div class="mb-3">
            <button type="submit" class="btn btn-secondary glassBackground" style="width:100px">Submit</button>
            <a asp-controller="Criminal" asp-action="DashboardView" id="ShowAccepted" type="submit" class=" col-3 btn btn-secondary  glassBackground" style="width:100px">Back</a>
            </div>
    </div>

   
   
</form>
</body>
